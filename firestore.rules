rules_version = '2';

// Regras de segurança do Firestore: quem pode ler e gravar o quê.
// Este texto é colado no console do Firebase (Firestore Database → Regras → Publicar).
//
// Cada aluno só pode ler e gravar dentro da própria pasta: usuarios/{o id dele}/...
// Qualquer outro caminho (ou alguém sem login) é recusado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /usuarios/{uid}/{documento=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
